{
  "name": "xops-operational-graph",
  "version": "1.0.0-poc",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/agent/**/*.test.ts",
    "demo:portfolio-risk": "tsx scripts/demo-portfolio-risk.ts",
    "verify": "node scripts/verify-acceptance.mjs",
